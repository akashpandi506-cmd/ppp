# ========================================================
# ChessVerse 3D - Environment Variables Configuration
# ========================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (e.g., https://your-project.vercel.app).
APP_URL="http://localhost:3000"

# VITE_BACKEND_URL: Optional for Vercel deployment.
# When deploying the static frontend to Vercel, set this to your hosted backend URL
# (e.g., https://chessverse-3d.onrender.com) to route real-time WebSocket and API calls.
# Leave blank or omit for local unified development (defaults to same-origin).
VITE_BACKEND_URL=""

# PORT: Server port (default 3000)
PORT=3000

# NODE_ENV: Application environment ('development' | 'production')
NODE_ENV=production
